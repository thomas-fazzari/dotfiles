font-family = JetBrainsMono Nerd Font Mono
font-size = 16
font-style = Medium
font-style-italic = Medium Italic

command = /opt/homebrew/bin/fish

background = #08080B
foreground = #C8D3F5
cursor-color = #C8D3F5
cursor-text = #08080B
selection-background = #2F334D
selection-foreground = cell-foreground

background-opacity = 0.85
background-blur = true

palette = 0=#3B4261
palette = 1=#FF757F
palette = 2=#C3E88D
palette = 3=#FFC777
palette = 4=#82AAFF
palette = 5=#C099FF
palette = 6=#86E1FC
palette = 7=#828BB8
palette = 8=#444A73
palette = 9=#FF8D94
palette = 10=#C7FB6D
palette = 11=#FFD8AB
palette = 12=#9AB8FF
palette = 13=#CAABFF
palette = 14=#B2EBFF
palette = 15=#C8D3F5

window-padding-x = 12
window-padding-y = 12
split-divider-color = #1E2030
macos-option-as-alt = true
copy-on-select = true

keybind = ctrl+v=paste_from_clipboard
keybind = performable:ctrl+c=copy_to_clipboard:mixed
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backspace=close_surface
keybind = ctrl+shift+f=toggle_split_zoom
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+arrow_left=resize_split:left,10
keybind = ctrl+shift+arrow_right=resize_split:right,10
keybind = ctrl+shift+arrow_up=resize_split:up,10
keybind = ctrl+shift+arrow_down=resize_split:down,10
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+n=next_tab
keybind = ctrl+shift+p=previous_tab
keybind = ctrl+shift+w=close_tab:this
keybind = super+shift+v=csi:118;10u

# Per-OS overrides, linked next to this file by scripts/setup-symlinks.pl
config-file = ?os.ghostty
