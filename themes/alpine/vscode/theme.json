  "semanticTokenColors": {
    "namespace": {
      "foreground": "#96dce0"
    },
    "type": {
      "foreground": "#7bd3e9"
    },
    "class": {
      "foreground": "#7bd3e9"
    },
    "enum": {
      "foreground": "#7bd3e9"
    },
    "interface": {
      "foreground": "#95d9ef"
    },
    "struct": {
      "foreground": "#7bd3e9"
    },
    "typeParameter": {
      "foreground": "#7bd3e9"
    },
    "parameter": {
      "foreground": "#e7d4bb"
    },
    "property": {
      "foreground": "#8ed3cc"
    },
    "enumMember": {
      "foreground": "#f7b983"
    },
    "event": {
      "foreground": "#7bd3e9"
    },
    "function": {
      "foreground": "#7cc2fd"
    },
    "method": {
      "foreground": "#7cc2fd"
    },
    "macro": {
      "foreground": "#96dce0"
    },
    "keyword": {
      "foreground": "#b5a7f5",
      "fontStyle": "italic"
    },
    "modifier": {
      "foreground": "#b5a7f5",
      "fontStyle": "italic"
    },
    "comment": {
      "foreground": "#6f8298",
      "fontStyle": "italic"
    },
    "string": {
      "foreground": "#95deae"
    },
    "number": {
      "foreground": "#f7b983"
    },
    "regexp": {
      "foreground": "#bbebe6"
    },
    "operator": {
      "foreground": "#97cfdd"
    },
    "decorator": {
      "foreground": "#96dce0"
    },
    "variable.defaultLibrary": {
      "foreground": "#ec918e"
    },
    "function.defaultLibrary": {
      "foreground": "#7bd3e9"
    },
    "method.defaultLibrary": {
      "foreground": "#7bd3e9"
    },
    "class.defaultLibrary": {
      "foreground": "#64b0d5"
    },
    "type.defaultLibrary": {
      "foreground": "#64b0d5"
    }
