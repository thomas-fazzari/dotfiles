[delta]
  minus-style                   = syntax "#28384a"
  minus-non-emph-style          = syntax "#28384a"
  minus-emph-style              = syntax "#5c3642"
  minus-empty-line-marker-style = syntax "#28384a"
  line-numbers-minus-style      = "#d58181"
  plus-style                    = syntax "#364351"
