      "settings": {
        "foreground": "#95e9f7"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#95e9f7"
      }
    },
    {
      "scope": [
        "punctuation.section",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "meta.brace.round",
        "meta.brace.square"
      ],
      "settings": {
        "foreground": "#809ab2"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#95e9f7"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#cde1f2"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#eedbc1"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#fe8a82"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#69ddcb"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#67bff8"
      }
    },
    {
      "scope": [
        "support.function"
      ],
      "settings": {
        "foreground": "#5bcdf3"
      }
    },
    {
      "scope": [
        "entity.name.function.method",
        "meta.method-call entity.name.function"
      ],
      "settings": {
        "foreground": "#67bff8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
