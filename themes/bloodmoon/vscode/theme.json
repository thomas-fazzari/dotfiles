  "semanticTokenColors": {
    "namespace": "#e2e4f6",
    "type": "#c0a2ff",
    "class": "#c0a2ff",
    "enum": "#c0a2ff",
    "struct": "#c0a2ff",
    "typeParameter": "#c0a2ff",
    "event": "#c0a2ff",
    "interface": {
      "foreground": "#c0a2ff",
      "fontStyle": "italic"
    },
    "parameter": "#f2d4aa",
    "property": "#7fd6e6",
    "enumMember": "#ffb98a",
    "function": "#b4c2ff",
    "method": "#b4c2ff",
    "macro": "#ffb98a",
    "keyword": "#82aaf5",
    "controlKeyword": "#e87a88",
    "modifier": "#82aaf5",
    "comment": {
      "foreground": "#6b70a8",
      "fontStyle": "italic"
    },
    "string": "#c2d68a",
    "number": "#ffb98a",
    "regexp": "#7fd6e6",
    "operator": "#9095bd",
    "decorator": "#ffb98a",
    "variable": "#e2e4f6",
    "variable.defaultLibrary": "#e87a88",
    "function.defaultLibrary": "#b4c2ff",
    "method.defaultLibrary": "#b4c2ff",
    "class.defaultLibrary": {
      "foreground": "#c0a2ff",
      "fontStyle": "italic"
    },
    "type.defaultLibrary": {
      "foreground": "#c0a2ff",
      "fontStyle": "italic"
    }
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6b70a8", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#c2d68a" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#7fd6e6" }
    },
    {
      "scope": ["constant.character.escape", "constant.character.format"],
      "settings": { "foreground": "#c0a2ff" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant", "variable.other.enummember"],
      "settings": { "foreground": "#ffb98a" }
    },
    {
      "scope": ["variable.other.constant"],
      "settings": { "foreground": "#e2e4f6" }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "storage.type.function",
        "keyword.function",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.other.import",
        "keyword.other.using",
        "keyword.other.namespace",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.word"
      ],
      "settings": { "foreground": "#82aaf5" }
    },
    {
      "scope": [
        "keyword.control.flow",
        "keyword.control.return",
        "keyword.control.conditional",
        "keyword.control.switch",
        "keyword.control.case",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.try",
        "keyword.control.exception",
        "keyword.control.context"
      ],
      "settings": { "foreground": "#e87a88" }
    },
    {
      "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator.key-value"],
      "settings": { "foreground": "#9095bd" }
    },
    {
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#c0a2ff" }
    },
    {
      "scope": ["variable", "meta.definition.variable"],
      "settings": { "foreground": "#e2e4f6" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#f2d4aa" }
    },
    {
      "scope": ["variable.language", "variable.language.this", "variable.language.self"],
      "settings": { "foreground": "#e87a88" }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": { "foreground": "#7fd6e6" }
    },
    {
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "support.function",
        "entity.name.function.method",
        "meta.method-call entity.name.function"
      ],
      "settings": { "foreground": "#b4c2ff" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": { "foreground": "#c0a2ff" }
    },
    {
      "scope": ["support.type.primitive", "support.type.builtin", "keyword.type"],
      "settings": { "foreground": "#c0a2ff", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": { "foreground": "#e2e4f6" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#82aaf5" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#c0a2ff" }
    },
    {
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "meta.attribute"],
      "settings": { "foreground": "#ffb98a" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#ffb98a", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link", "markup.link"],
      "settings": { "foreground": "#82aaf5" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": { "foreground": "#7fd6e6" }
    },
    {
      "scope": ["markup.list punctuation.definition.list", "markup.quote"],
      "settings": { "foreground": "#9095bd" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#c2d68a" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#e87a88" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#82aaf5" }
    }
  ]
}
