font-family = Iosevka Nerd Font Mono
font-size = 16

background = #1A1B26
foreground = #A9B1D6
cursor-color = #C0CAF5
cursor-text = #1A1B26
selection-background = #28344A
selection-foreground = cell-foreground

palette = 0=#414868
palette = 1=#F7768E
palette = 2=#73DACA
palette = 3=#E0AF68
palette = 4=#7AA2F7
palette = 5=#BB9AF7
palette = 6=#7DCFFF
palette = 7=#C0CAF5
palette = 8=#414868
palette = 9=#F7768E
palette = 10=#73DACA
palette = 11=#E0AF68
palette = 12=#7AA2F7
palette = 13=#BB9AF7
palette = 14=#7DCFFF
palette = 15=#C0CAF5

window-padding-x = 12
window-padding-y = 12
split-divider-color = #414868
macos-option-as-alt = true
copy-on-select = true

keybind = ctrl+v=paste_from_clipboard
keybind = performable:ctrl+c=copy_to_clipboard:mixed
keybind = ctrl+shift+enter=new_split:right
keybind = ctrl+shift+backspace=close_surface
keybind = ctrl+shift+f=toggle_split_zoom
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+arrow_left=resize_split:left,10
keybind = ctrl+shift+arrow_right=resize_split:right,10
keybind = ctrl+shift+arrow_up=resize_split:up,10
keybind = ctrl+shift+arrow_down=resize_split:down,10
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+n=next_tab
keybind = ctrl+shift+p=previous_tab
keybind = ctrl+shift+w=close_tab:this
