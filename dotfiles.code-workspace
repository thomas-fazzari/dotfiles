{
  "folders": [{ "path": "." }],
  "settings": {
    "Lua.diagnostics.disable": ["undefined-global", "undefined-doc-name", "different-requires"],
    "json.schemas": [
      { "fileMatch": ["**/vscode/settings.json"], "url": "vscode://schemas/settings/user" },
      {
        "fileMatch": ["**/vscode/keybindings.json"],
        "url": "vscode://schemas/keybindings",
      },
    ],
    "perlnavigator.includePaths": ["$workspaceFolder/agentic/hooks/lib"],
    "kdl.enable": false,
    "[lua]": { "editor.defaultFormatter": "JohnnyMorganz.stylua" },
  },
}
