{
  "folders": [{ "path": "." }],
  "settings": {
    "Lua.diagnostics.disable": ["undefined-global", "undefined-doc-name", "different-requires"],
    "files.associations": {
      "**/git/.gitignore_global": "ignore",
      ".perltidyrc": "properties",
    },
    "files.exclude": {
      "**/.git": true,
      "**/.DS_Store": true,
      ".mise": true,
      "**/*.lock": true,
      "**/*-lock.json": true,
    },
    "files.watcherExclude": {
      ".mise/**": true,
      "wallpapers/**": true,
    },
    "search.exclude": {
      "wallpapers": true,
    },
  },
}
