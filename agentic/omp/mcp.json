{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "context-mode": {
      "type": "stdio",
      "command": "node",
      "args": [
        "/Users/thomas/.omp/plugins/node_modules/context-mode/server.bundle.mjs"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "nuget": {
      "type": "stdio",
      "command": "dnx",
      "args": [
        "NuGet.Mcp.Server",
        "--source",
        "https://api.nuget.org/v3/index.json",
        "--yes"
      ]
    },
    "binlog-mcp": {
      "type": "stdio",
      "command": "binlog-mcp"
    },
    "fff": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/fff-mcp"
    }
  },
  "disabledServers": [
    "computer-use"
  ]
}
