{
  "env": {
    "GIT_CONFIG_COUNT": "4",
    "GIT_CONFIG_KEY_0": "status.short",
    "GIT_CONFIG_VALUE_0": "true",
    "GIT_CONFIG_KEY_1": "status.branch",
    "GIT_CONFIG_VALUE_1": "true",
    "GIT_CONFIG_KEY_2": "format.pretty",
    "GIT_CONFIG_VALUE_2": "%h %ad %an %s",
    "GIT_CONFIG_KEY_3": "log.date",
    "GIT_CONFIG_VALUE_3": "short",
    "GIT_TERMINAL_PROMPT": "0",
    "CARGO_TERM_QUIET": "true",
    "NEXTEST_STATUS_LEVEL": "fail",
    "NEXTEST_FINAL_STATUS_LEVEL": "fail",
    "DOTNET_NOLOGO": "1"
  },
  "permissions": {
    "allow": [
      "LSP",
      "Edit",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "mcp__fff__*",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(fzf *)",
      "Bash(jq *)",
      "Bash(bat *)",
      "Bash(pwd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(sed *)",
      "Bash(find *)",
      "Bash(sort -n)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git rev-parse *)",
      "Bash(git remote *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr status *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh repo view *)",
      "Bash(gh search *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo build *)",
      "Bash(cargo fmt *)",
      "Bash(cargo deny check *)",
      "Bash(dotnet *)",
      "Bash(bunx oxlint *)",
      "Bash(bunx vitest *)",
      "Bash(just *)",
      "Bash(mise *)",
      "Bash(bun *)"
    ],
    "deny": ["Bash(rm -rf *)", "Read(*.env)", "Read(*.env.*)", "Read(!*.env.example)"],
    "defaultMode": "auto"
  },
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$HOME\"/.claude/hooks/bash-guard.pl" }]
      }
    ]
  },
  "model": "opus",
  "cleanupPeriodDays": 60,
  "skillOverrides": {
    "code-review": "off",
    "security-review": "off",
    "run": "off",
    "init": "off",
    "loop": "off",
    "schedule": "off",
    "fewer-permission-prompts": "off",
    "keybindings-help": "off",
    "workflow-authoring": "off",
    "dataviz": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off",
    "anthropic-skills:consolidate-memory": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:explain-usage": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:setup-claude": "off",
    "anthropic-skills:schedule": "off"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "outputStyle": "Concise",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "tui": "fullscreen"
}
