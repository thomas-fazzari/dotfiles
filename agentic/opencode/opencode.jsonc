{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
  },
  "agent": {
    "explore": {
      "permission": {
        "fff_*": "allow",
        "lsp": "allow",
      },
    },
  },
  "formatter": {
    "csharpier": {
      "command": ["csharpier", "format", "$FILE"],
      "extensions": [".cs"],
    },
  },
  "lsp": {
    "rust": {
      "command": ["rust-analyzer"],
    },
    "csharp": {
      "command": ["roslyn-language-server", "--stdio", "--autoLoadProjects"],
    },
    "typescript": {
      "command": ["tsc", "--lsp", "--stdio"],
    },
  },
  "mcp": {
    "fff": {
      "type": "local",
      "command": ["fff-mcp"],
      "enabled": true,
    },
    "nuget": {
      "type": "local",
      "command": [
        "/opt/homebrew/opt/dotnet/libexec/dnx",
        "NuGet.Mcp.Server",
        "--source",
        "https://api.nuget.org/v3/index.json",
        "--yes",
      ],
      "enabled": true,
      "timeout": 120000,
    },
  },
  "autoupdate": "notify",
  "permission": {
    "lsp": "allow",
    "bash": {
      "*": "ask",
      "rg": "allow",
      "rg *": "allow",
      "fd": "allow",
      "fd *": "allow",
      "fzf": "allow",
      "fzf *": "allow",
      "jq": "allow",
      "jq *": "allow",
      "bat": "allow",
      "bat *": "allow",
      "pwd": "allow",
      "pwd *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat": "allow",
      "cat *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "sed": "allow",
      "sed *": "allow",
      "find": "allow",
      "find *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "gh": "allow",
      "gh *": "allow",
      "cargo check": "allow",
      "cargo check *": "allow",
      "cargo test": "allow",
      "cargo test *": "allow",
      "cargo clippy": "allow",
      "cargo clippy *": "allow",
      "cargo build": "allow",
      "cargo build *": "allow",
      "cargo fmt": "allow",
      "cargo fmt *": "allow",
      "cargo deny check": "allow",
      "cargo deny check *": "allow",
      "dotnet": "allow",
      "dotnet *": "allow",
      "bunx oxlint": "allow",
      "bunx oxlint *": "allow",
      "bunx vitest": "allow",
      "bunx vitest *": "allow",
      "just": "allow",
      "just *": "allow",
      "bun": "allow",
      "bun *": "allow",
      "rm -rf": "deny",
      "rm -rf *": "deny",
    },
    "webfetch": "allow",
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/.idea/**",
      "**/node_modules/**",
      "**/dist/**",
      "**/build/**",
      "**/_build/**",
      "**/coverage/**",
      "**/.next/**",
      "**/.svelte-kit/**",
      "**/.turbo/**",
      "**/.venv/**",
      "**/bin/**",
      "**/obj/**",
      "**/TestResults/**",
      "**/target/**",
    ],
  },
}
