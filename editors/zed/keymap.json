[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-enter": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "ctrl-alt-enter": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-alt-s": "pane::SplitRight",
      "ctrl-alt-k": "pane::CloseActiveItem",
      "ctrl-alt-h": "workspace::ActivatePaneLeft",
      "ctrl-alt-l": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "ctrl-l": "project_panel::ToggleFocus",
      "escape": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore",
    },
  },
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      "space c": "editor::ToggleComments",
    },
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      // Sneak and jump labels (easymotion)
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
      "space space": "vim::HelixJumpToWord",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      // LSP
      "g r": "editor::FindAllReferences",
      "g i": "editor::GoToImplementation",
      "g t": "editor::GoToTypeDefinition",
      "g p d": "editor::GoToDefinitionSplit",
      "g p i": "editor::GoToImplementationSplit",
      "g p t": "editor::GoToTypeDefinitionSplit",
      "space q": "editor::ToggleCodeActions",
      "space r n": "editor::Rename",

      // Editor
      "space s": "workspace::Save",
      "space x": "pane::CloseActiveItem",
      "space c": "editor::ToggleComments",

      // Navigation
      "space e": "workspace::ToggleLeftDock",
      "space f e": "project_panel::ToggleFocus",
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space f r": "pane::DeploySearch",
      "space f p": "command_palette::Toggle",
      "space f o": "outline::Toggle",
      "space f s": "project_symbols::Toggle",
      "space h h": "tab_switcher::Toggle",

      // Git
      "space g c": "git::Branch",
      "space g n": "git::Branch",
      "space g p": "git::Pull",

      // Tasks (cargo run/test under cursor)
      "space t t": "editor::SpawnNearestTask",
      "space t r": "task::Rerun",
      "space t s": "task::Spawn",
    },
  },
]
