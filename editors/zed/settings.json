{
  // fonts
  "disable_ai": true,
  "diff_view_style": "split",
  "buffer_font_family": "Iosevka Nerd Font Mono",
  "buffer_font_size": 16,
  "buffer_font_weight": 500,
  "buffer_line_height": { "custom": 1.3 },
  "ui_font_size": 16,
  "text_rendering_mode": "platform_default",
  "markdown_preview": { "code_font_family": "Iosevka Nerd Font Mono" },

  // appearance
  "theme": "Tokyo Night",
  // custom Tokyo Night Dark port
  // only the window background is tinted, the rest is transparent over the OS wallpaper
  "theme_overrides": {
    "Tokyo Night": {
      "background.appearance": "transparent",
      "background": "#08080BE6",
      "surface.background": "#0D0E14",
      "elevated_surface.background": "#0D0E14",
      "panel.background": "#00000000",
      "editor.background": "#00000000",
      "editor.gutter.background": "#00000000",
      "editor.active_line.background": "#A9B1D60A",
      "editor.foreground": "#A9B1D6",
      "terminal.background": "#00000000",
      "terminal.foreground": "#A9B1D6",
      "title_bar.background": "#00000000",
      "title_bar.inactive_background": "#00000000",
      "status_bar.background": "#00000000",
      "tab_bar.background": "#00000000",
      "toolbar.background": "#00000000",
      "border": "#1E202E",
      "border.variant": "#1E202E",
      "pane_group.border": "#1E202E",
      "scrollbar.track.background": "#00000000",
      "syntax": {
        "property.json_key": { "color": "#7AA2F7" },
      },
    },
  },
  "icon_theme": "Material Icon Theme",
  "cursor_shape": "bar",
  "current_line_highlight": "gutter",
  "vertical_scroll_margin": 6,
  "show_wrap_guides": true,
  "minimap": { "show": "never" },
  "sticky_scroll": { "enabled": false },
  "scrollbar": { "show": "never" },
  "toolbar": { "breadcrumbs": false, "quick_actions": false },
  "tab_bar": {
    "show": false,
    "show_nav_history_buttons": false,
  },
  "tabs": { "file_icons": false, "git_status": false },
  "title_bar": {
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_branch_name": true,
    "show_branch_status_icon": false,
  },
  "status_bar": {
    "line_endings_button": false,
    "active_encoding_button": "disabled",
    "active_language_button": false,
  },
  "git": { "git_gutter": "hide" },
  "colorize_brackets": true,
  "inlay_hints": { "enabled": true },

  // error lens
  "diagnostics": {
    "button": true,
    "inline": { "enabled": true },
  },

  // panels
  "project_panel": {
    "dock": "left",
    "indent_size": 22,
    "auto_reveal_entries": true,
    "default_width": 240,
    "button": true,
    "hide_root": true,
    "hide_gitignore": false,
    "sort_mode": "directories_first",
    "entry_spacing": "standard",
    "folder_indicator": "icon",
    "bold_folder_labels": false,
    "diagnostic_badges": true,
    "git_status_indicator": false,
    "indent_guides": { "show": "never" },
    "scrollbar": { "show": "never" },
  },
  "outline_panel": { "dock": "left", "indent_size": 20 },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
    "file_icons": true,
    "status_style": "icon",
    "sort_by": "path",
    "group_by": "staging",
    "show_count_badge": true,
    "fallback_branch_name": "master",
    "entry_primary_click_action": "file_diff",
  },
  "collaboration_panel": { "dock": "left", "button": false },
  "debugger": { "button": false },
  "search": { "button": false },

  // editor behavior
  "format_on_save": "on",
  "soft_wrap": "editor_width",
  "tab_size": 2,
  "linked_edits": true,
  "autosave": { "after_delay": { "milliseconds": 2000 } },
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "restore_on_startup": "empty_tab",
  "when_closing_with_no_tabs": "keep_window_open",
  "on_last_window_closed": "quit_app",
  "confirm_quit": false,
  "session": { "trust_all_worktrees": true },
  "file_scan_exclusions": [
    "**/.git",
    "**/.jj",
    "**/.DS_Store",
    "**/.idea",
    "**/node_modules",
    "**/target",
    "**/blib",
  ],

  // terminal
  "terminal": {
    "shell": { "program": "/usr/bin/fish" },
    "dock": "right",
    "font_family": "Iosevka Nerd Font Mono",
    "font_size": 14,
    "blinking": "on",
    "copy_on_select": true,
    "button": false,
    "show_count_badge": false,
    "scrollbar": { "show": "never" },
    "toolbar": { "breadcrumbs": false },
  },

  // vim
  "vim_mode": true,
  "base_keymap": "VSCode",
  "relative_line_numbers": "disabled",
  "vim": {
    "use_system_clipboard": "always",
    "use_smartcase_find": true,
    "highlight_on_yank_duration": 250,
  },

  // lang
  "languages": {
    "Rust": {
      "tab_size": 4,
      "preferred_line_length": 100,
      "wrap_guides": [100],
    },
    "Perl": {
      "tab_size": 4,
    },
    // formatted by oxfmt (picks the worktree's node_modules when present)
    "JSON": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "prettier": { "allowed": false },
    },
    "JSONC": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "prettier": { "allowed": false },
    },
    "Markdown": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "prettier": { "allowed": false },
      "language_servers": ["markdownlint", "..."],
    },
    "MDX": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "prettier": { "allowed": false },
      "language_servers": ["markdownlint", "..."],
    },
    "YAML": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
      "prettier": { "allowed": false },
    },
    "TOML": {
      "formatter": [{ "language_server": { "name": "oxfmt" } }],
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": { "command": "clippy" },
        "cargo": { "buildScripts": { "enable": true } },
        "procMacro": { "enable": true },
        "imports": { "granularity": { "group": "module" } },
        "inlayHints": {
          "closureReturnTypeHints": { "enable": "with_block" },
          "lifetimeElisionHints": { "enable": "skip_trivial" },
        },
      },
    },
    "perlnavigator-server": {
      "settings": {
        "perlnavigator": { "perlPath": "/usr/bin/perl" },
      },
    },
  },

  // extensions
  "auto_install_extensions": {
    "tokyo-night": true,
    "material-icon-theme": true,
    "oxc": true,
    "markdownlint": true,
    "perl": true,
    "mdx": true,
    "toml": true,
    "sql": true,
    "wgsl-wesl": true,
    "fluent": true,
  },

  // misc
  "telemetry": { "diagnostics": false, "metrics": false },
}
